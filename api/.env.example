# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

PORT=4000
APP_NAME=HustleHub+
NODE_ENV=development

# Must match the scheme and port the React client is served on.
# The client runs over HTTPS, so http here causes CORS to reject every request.
CLIENT_ORIGIN=https://localhost:5173

USE_HTTPS=true
SSL_KEY_PATH=
SSL_CERT_PATH=

MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h
